# Шаблон обрабатывается envsubst при старте контейнера nginx (подставляются BACKEND_URL и DNS_RESOLVER).
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 1m;

    # Адрес бэкенда резолвится при запросе, а не при старте:
    # фронт поднимается, даже если бэкенд ещё не готов (тогда включится демо-режим).
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 180s;
        proxy_buffering off;
    }

    location = /config.js {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
