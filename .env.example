# Только имена переменных и пояснения (ARCHITECTURE.md §16.1).
# Секретные значения заполняются локально в .env и не коммитятся.
#
# ВАЖНО ДЛЯ АГЕНТОВ: этот файл — единственный источник имён переменных.
# Файл .env агент не читает, значения секретов не выводит и не коммитит.
# В примерах кода использовать плейсхолдер <set-me>.

# --- PostgreSQL ---
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
# Пароль прикладной роли без BYPASSRLS; задаётся локально.
POSTGRES_PASSWORD=
DATABASE_URL=

# --- DeepSeek V4.1 Flash через предоставленный прокси ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Эмбеддинги BGE-M3 (1024 измерения) ---
EMB_MODEL=BAAI/bge-m3
EMBEDDER_API_KEY=

# --- Qwen3 Reranker 8B ---
RERANKER_MODEL=
RERANKER_API_KEY=

# --- Конкурсный режим ---
DATA_DIR=
TOP_K=30
RERANKER_TOP_N=10
TEMPERATURE=0.0
MAX_TOKENS=1500
MAX_WORKERS=4
