# --- PostgreSQL ---
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
# Пароль прикладной роли без BYPASSRLS; задаётся локально.
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Backend API ---
APP_USER_LOGIN=<set-me>
APP_USER_PASSWORD=<set-me>
API_PORT=8001
FRONTEND_PORT=8081
CORPUS_ID=
INDEX_GENERATION_ID=

# --- DeepSeek V4.1 Flash через предоставленный прокси ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_DEV=

# --- Эмбеддинги BGE-M3 (1024 измерения) ---
EMB_MODEL=BAAI/bge-m3
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=

# --- Qwen3 Reranker ---
RERANKER_MODEL=
RERANKER_BASE_URL=
RERANKER_API_KEY=

# --- RAG runtime ---
RAG_MODEL_TIMEOUT_SECONDS=300
RAG_REQUEST_TIMEOUT_SECONDS=330

# --- Конкурсный режим ---
DATA_DIR=
TOP_K=30
RERANKER_TOP_N=10
TEMPERATURE=0.3
MAX_TOKENS=1500
MAX_WORKERS=4
