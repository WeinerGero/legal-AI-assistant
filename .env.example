# --- PostgreSQL ---
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=<set-me>

# --- Веб-приложение и авторизация ---
APP_USER_LOGIN=<set-me>
APP_USER_PASSWORD=<set-me>
API_PORT=8001
FRONTEND_PORT=8082

# --- DeepSeek ---
LLM_BASE_URL=https://matreshkaapi.mooo.com/v1
LLM_DEV=<set-me>
LLM_MODEL=deepseek-v4.1-flash

# --- BGE-M3 ---
EMB_MODEL=BAAI/bge-m3
EMBEDDER_BASE_URL=http://host.docker.internal:8081/v1
EMBEDDER_API_KEY=local

# --- Qwen3 Reranker ---
RERANKER_MODEL=qwen/qwen3-reranker-4b
RERANKER_BASE_URL=http://host.docker.internal:8080/v1
RERANKER_API_KEY=local

# --- Юридический RAG ---
RAG_MODEL_TIMEOUT_SECONDS=300
RAG_REQUEST_TIMEOUT_SECONDS=330
RAG_READINESS_PROBE_INTERVAL_SECONDS=30
RAG_READINESS_RETRY_INTERVAL_SECONDS=5
RAG_READINESS_PROBE_TIMEOUT_SECONDS=10
# CORPUS_ID и INDEX_GENERATION_ID вычисляются при запуске integration.run.

# --- Необязательный конкурсный режим ---
DATA_DIR=
TOP_K=30
RERANKER_TOP_N=10
TEMPERATURE=0.3
MAX_TOKENS=1500
MAX_WORKERS=4
